# Copy this file to functions/.env and fill in real values.
# Keep functions/.env private and never commit it.

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Auction Stripe mode toggle (true = live keys, false = test keys)
AUCTION_LIVE=false
AUCTION_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_replace_me
AUCTION_STRIPE_SECRET_KEY_LIVE=sk_live_replace_me
AUCTION_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_replace_me
AUCTION_STRIPE_SECRET_KEY_TEST=sk_test_replace_me

# Mailer
MAIL_EMAIL=your_email@example.com
MAIL_PASSWORD=your_mail_app_password

# Optional base URLs
APP_URL=https://ydeseniors.com
SITE_URL=https://ydeseniors.com
